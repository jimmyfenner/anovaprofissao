{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/transicaoenergetica",
      "destination": "/transicao-energetica",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "querovendercarregador.com.br"
        }
      ],
      "destination": "/seo/querovendercarregador.com.br/robots.txt"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "www.querovendercarregador.com.br"
        }
      ],
      "destination": "/seo/querovendercarregador.com.br/robots.txt"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "transicaoenergetica.com.br"
        }
      ],
      "destination": "/seo/transicaoenergetica.com.br/robots.txt"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "www.transicaoenergetica.com.br"
        }
      ],
      "destination": "/seo/transicaoenergetica.com.br/robots.txt"
    },
    {
      "source": "/robots.txt",
      "destination": "/seo/anovaprofissao.com.br/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "querovendercarregador.com.br"
        }
      ],
      "destination": "/seo/querovendercarregador.com.br/sitemap.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "www.querovendercarregador.com.br"
        }
      ],
      "destination": "/seo/querovendercarregador.com.br/sitemap.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "transicaoenergetica.com.br"
        }
      ],
      "destination": "/seo/transicaoenergetica.com.br/sitemap.xml"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "www.transicaoenergetica.com.br"
        }
      ],
      "destination": "/seo/transicaoenergetica.com.br/sitemap.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/seo/anovaprofissao.com.br/sitemap.xml"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "querovendercarregador.com.br"
        }
      ],
      "destination": "/integradores"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.querovendercarregador.com.br"
        }
      ],
      "destination": "/integradores"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "transicaoenergetica.com.br"
        }
      ],
      "destination": "/transicao-energetica"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.transicaoenergetica.com.br"
        }
      ],
      "destination": "/transicao-energetica"
    },
    {
      "source": "/",
      "destination": "/home"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
